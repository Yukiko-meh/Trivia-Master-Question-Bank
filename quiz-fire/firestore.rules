rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每場比賽(房間)的成績:任何人可讀;只能新增一次,不能改、不能刪。
    match /rooms/{room}/scores/{id} {
      allow read: if true;
      allow create: if room.matches('^((g[1-6]|j[1-3])+)-[0-9]{1,2}-([cmnsef]{1,6}-)?[a-z0-9]{3,8}$')
        && request.resource.data.keys().hasOnly(['name','score','total','ms','key','at'])
        && request.resource.data.keys().hasAll(['name','score','total','ms','key','at'])
        && request.resource.data.name is string
        && request.resource.data.name == id
        && id.size() >= 1 && id.size() <= 8
        && request.resource.data.total is int
        && request.resource.data.total >= 1 && request.resource.data.total <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.ms is int
        && request.resource.data.ms >= 0 && request.resource.data.ms <= 3600000
        && request.resource.data.key is int
        && request.resource.data.at is int
        && (!exists(/databases/$(database)/documents/rooms/$(room)/ctl/state)
            || get(/databases/$(database)/documents/rooms/$(room)/ctl/state).data.status != 'closed');
      allow update, delete: if false;
    }

    // 主辦人控制:狀態只有建立它的人(匿名登入的 uid)能改。
    match /rooms/{room}/ctl/state {
      allow read: if true;
      allow create: if request.auth != null
        && room.matches('^((g[1-6]|j[1-3])+)-[0-9]{1,2}-([cmnsef]{1,6}-)?[a-z0-9]{3,8}$')
        && request.resource.data.keys().hasOnly(['owner','status','at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status in ['open','waiting']
        && request.resource.data.at is int;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner','status','at'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.status in ['open','waiting','running','closed']
        && request.resource.data.at is int;
      allow delete: if false;
    }
  }
}
